# Start with built-in sample invoices; no API key is needed.
SAMPLE_DATA=true

# To use a real API, set SAMPLE_DATA=false and configure these values:
INVOICE_API_URL=https://api.example.com/invoices
INVOICE_API_TOKEN=
# Comma-separated file hostnames. Defaults to the API URL hostname.
INVOICE_API_ALLOWED_FILE_HOSTS=api.example.com,files.example.com
# Enable only for a trusted local/test API; invoice file URLs otherwise require HTTPS.
ALLOW_INSECURE_HTTP=false
# Optional custom path to the Tesseract executable on Windows.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
DATABASE_PATH=data/invoices.db
